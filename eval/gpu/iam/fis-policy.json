{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InterruptTaggedOnly",
      "Effect": "Allow",
      "Action": "ec2:SendSpotInstanceInterruptions",
      "Resource": "arn:aws:ec2:*:${account}:instance/*",
      "Condition": {"StringEquals": {"aws:ResourceTag/gmesh-train": "1"}}
    },
    {
      "Sid": "Describe",
      "Effect": "Allow",
      "Action": "ec2:DescribeInstances",
      "Resource": "*"
    }
  ]
}
