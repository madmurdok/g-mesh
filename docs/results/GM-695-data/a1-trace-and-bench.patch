+/// GM-695 throwaway offline order bench (not production).
+#[cfg(test)]
+mod gm695_bench {
+    use super::*;
+    use crate::embedding::model::{default_model_dir, EmbeddingModel, EncoderSpec, InferenceOptions};
+    use crate::embedding::text::node_text;
+    use std::io::Write;
+    use std::time::Instant;
+
+    fn sh(cmd: &str) -> String {
+        let out = std::process::Command::new("sh").arg("-c").arg(cmd).output().unwrap();
+        String::from_utf8_lossy(&out.stdout).split_whitespace().collect::<Vec<_>>().join(" ")
+    }
+
+    #[test]
+    #[ignore]
+    fn gm695_order_bench() {
+        let db = std::env::var("GM695_DB").unwrap();
+        let rounds = std::env::var("GM695_ROUNDS").unwrap_or_else(|_| "A0 A1 A1 A0".into());
+        let out_path = std::env::var("GM695_OUT").unwrap();
+        let conn = Connection::open_with_flags(&db, rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY).unwrap();
+        let mut all = Vec::new();
+        let mut after: Option<String> = None;
+        loop {
+            let page = fetch_candidate_page(&conn, "gm695-none", after.as_deref(), 1000).unwrap();
+            if page.is_empty() {
+                break;
+            }
+            after = Some(page.last().unwrap().id.clone());
+            all.extend(page);
+        }
+        let mut items: Vec<(EmbedTier, String)> = Vec::new();
+        for c in all {
+            let tier = candidate_tier(&c);
+            let node = to_node_record(c);
+            let input = crate::embedding::text::EmbedInput::from(&node);
+            if let Some(text) = node_text(&input) {
+                items.push((tier, text));
+            }
+        }
+        let id_order: Vec<usize> = (0..items.len()).collect();
+        let mut tier_order = id_order.clone();
+        tier_order.sort_by_key(|&i| (items[i].0, i));
+        let dir = default_model_dir(&crate::config::EmbeddingConfig::default().model).unwrap();
+        let model =
+            EmbeddingModel::load_with_options(&dir, EncoderSpec::production(), &InferenceOptions::from_env()).unwrap();
+        let mut out = std::fs::File::create(&out_path).unwrap();
+        let tiers: Vec<&str> = items.iter().map(|(t, _)| t.as_str()).collect();
+        writeln!(out, "{}", serde_json::json!({"texts": items.len(), "tiers": tiers})).unwrap();
+        for i in 0..100.min(items.len()) {
+            model.embed(&items[i].1).unwrap();
+        }
+        for (r, arm) in rounds.split_whitespace().enumerate() {
+            let order = if arm == "A0" { &id_order } else { &tier_order };
+            let state0 = sh("sysctl -n vm.loadavg; pmset -g therm | grep CPU_Speed_Limit");
+            let mut ms = vec![0f64; items.len()];
+            let t0 = Instant::now();
+            for &i in order {
+                let t = Instant::now();
+                model.embed(&items[i].1).unwrap();
+                ms[i] = t.elapsed().as_secs_f64() * 1e3;
+            }
+            let wall = t0.elapsed().as_secs_f64();
+            let state1 = sh("sysctl -n vm.loadavg; pmset -g therm | grep CPU_Speed_Limit");
+            writeln!(out, "{}", serde_json::json!({"round": r, "arm": arm, "wall": wall, "before": state0, "after": state1, "ms": ms}))
+                .unwrap();
+            out.flush().unwrap();
+            eprintln!("GM695 round {r} {arm} wall={wall:.1}s before=[{state0}] after=[{state1}]");
+        }
+    }
+}
